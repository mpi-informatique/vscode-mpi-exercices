  "MPI — Théorème avec titre": {
    "prefix": [
      "thmt",
      "theorem-title"
    ],
    "body": [
      "#theorem(title: [${1:Titre}])[",
      "  ${2:${TM_SELECTED_TEXT}}",
      "] <${3:thm-etiquette}>",
      "$0"
    ],
    "description": "Théorème avec titre et étiquette pour les renvois @ (bibliothèque MPI)"
  },
  "MPI — Exercice et solution de cours": {
    "prefix": [
      "exsol",
      "exercise-solution"
    ],
    "body": [
      "#exercise[",
      "  ${1:Énoncé}",
      "]",
      "#solution[",
      "  ${2:Solution}",
      "]",
      "$0"
    ],
    "description": "Exercice encadré suivi de sa solution dans un cours (bibliothèque MPI)"
  },
  "MPI — Solution avec pause": {
    "prefix": [
      "solpause"
    ],
    "body": [
      "#solution[",
      "  #pause",
      "  ${1:${TM_SELECTED_TEXT}}",
      "]",
      "$0"
    ],
    "description": "Solution révélée après une pause en présentation (bibliothèque MPI)"
  },
  "MPI — Question de banque": {
    "prefix": [
      "question",
      "ques"
    ],
    "body": [
      "question(",
      "  [${1:Énoncé}],",
      "  solution: [${2:Solution}],",
      "),",
      "$0"
    ],
    "description": "Question dans le tuple contenu: (...) d’un exercice, sans # (bibliothèque MPI)"
  },
  "MPI — Question avec barème": {
    "prefix": [
      "question-bareme",
      "quesb"
    ],
    "body": [
      "question(",
      "  [${1:Énoncé}],",
      "  solution: [${2:Solution}],",
      "  bareme: ${3|0.25,0.5,1,1.5,2,2.5,3,3.5,4|},",
      "  label: <${4:q-etiquette}>,",
      "),",
      "$0"
    ],
    "description": "Question avec points et étiquette dans contenu: (...) (bibliothèque MPI)"
  },
  "MPI — Exercice réutilisable": {
    "prefix": [
      "exercice-banque",
      "exbank"
    ],
    "body": [
      "#import \"/load.typ\": exercice, question",
      "",
      "#let ex = exercice(",
      "  meta: (",
      "    titre: \"${1:Titre}\",",
      "    chapitres: (\"${2:graphes}\",),",
      "    difficulte: ${3|1,2,3,4,5|},",
      "    niveaux: (\"${4:MPI}\",),",
      "    duree: (${5:0}, ${6:20}),",
      "  ),",
      "  contenu: (",
      "    question(",
      "      [${7:Énoncé}],",
      "      solution: [${8:Solution}],",
      "    ),",
      "  ),",
      ")",
      "$0"
    ],
    "description": "Fichier complet exportant ex ; adapter les métadonnées au vocabulaire de la banque MPI"
  }
}
